{
  "uid": "platform-ingress",
  "title": "Platform / Ingress (Traefik)",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Requests / sec",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(traefik_service_requests_total[5m]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "5xx / sec",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(traefik_service_requests_total{code=~\"5..\"}[5m]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "429 / sec",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(traefik_router_requests_total{code=\"429\"}[5m]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Requests by Router / Status",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (router, code) (rate(traefik_router_requests_total[5m]))"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency p95 (seconds)",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 7 },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traefik_service_request_duration_seconds_bucket[5m])))"
        }
      ]
    }
  ]
}
